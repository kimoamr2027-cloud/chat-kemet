rules_version = '2';

// قواعد أمان شات كيمت
// - محدش يقرا أي حاجة من غير ما يسجل دخول
// - كل عضو يعدّل بياناته هو بس
// - الرسالة لازم تتبعت باسم صاحبها الحقيقي، ومحدش يعدّل رسالة حد تاني
//   (الاستثناء الوحيد: كل عضو يقدر يحط أو يشيل التفاعل بتاعه هو بس)
// - الخاص: المحظور ميقدرش يبعت، وإعداد "مين يقدر يبعتلك" بيتطبق هنا مش في التطبيق بس
// - البلاغات: أي عضو يبعت بلاغ، ومحدش يقراها غير صاحب المشروع من الـ Console
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // ===== الأدوار: الأدمن والمشرفين (في config/roles) =====
    function roles() {
      return get(/databases/$(database)/documents/config/roles).data;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid in roles().get('admins', []);
    }
    function isRoomMod(roomId) {
      return isAdmin() || (signedIn() && request.auth.uid in roles().get('mods', {}).get(roomId, []));
    }
    // محظور من التطبيق كله (الأدمن بس اللي بيحظر)
    function appBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }
    // كتم أو طرد شغال دلوقتي في الغرفة
    function restricted(roomId, type) {
      let p = /databases/$(database)/documents/rooms/$(roomId)/restrict/$(request.auth.uid);
      return exists(p) && get(p).data.until > request.time && (type == 'any' || get(p).data.type == type);
    }

    // الغرف الأساسية بس — أول عضو يدخل بيعملها، ومحدش يقدر يعدّلها أو يمسحها من التطبيق
    function defaultRooms() {
      return {
        'pyramids': {'name': 'غرفة الأهرامات', 'order': 1},
        'nile': {'name': 'نهر النيل', 'order': 2},
        'luxor': {'name': 'الأقصر وأسوان', 'order': 3},
        'alex': {'name': 'إسكندرية', 'order': 4},
        'youth': {'name': 'شباب كيمت', 'order': 5},
        'history': {'name': 'تاريخ مصر القديمة', 'order': 6}
      };
    }

    // mediaPath: مكان ملف الصورة أو الفويس (لازم يكون بتاع نفس المرسل ومن نفس النوع)
    function validContent(d, mediaPath) {
      return d.createdAt == request.time
        && (
          (d.kind == 'text' && str(d.text, 1, 1000) && !('sticker' in d) && !('media' in d) && cleanText(d.text))
          || (d.kind == 'sticker' && d.sticker is int && d.sticker >= 0 && d.sticker <= 5 && !('text' in d) && !('media' in d))
          || (d.kind == 'image' && str(d.media, 1, 40) && d.w is int && d.h is int && d.w > 0 && d.h > 0
              && d.w <= 4000 && d.h <= 4000 && !('text' in d) && !('sticker' in d) && mediaOk(mediaPath, 'image')
              // نسخة صغيرة من الصورة بتظهر في الشات على طول
              && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 30000 && d.thumb.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))))
          || (d.kind == 'voice' && str(d.media, 1, 40) && d.dur is int && d.dur >= 1 && d.dur <= 60
              && !('text' in d) && !('sticker' in d) && mediaOk(mediaPath, 'voice'))
          // دعوة لترابيزة لودو (صاحب الترابيزة بس اللي يبعتها)
          || (d.kind == 'ludo' && str(d.table, 1, 40) && str(d.text, 1, 200) && !('sticker' in d) && !('media' in d)
              && get(/databases/$(database)/documents/ludo/$(d.table)).data.host == request.auth.uid)
          || (d.kind == 'snakes' && str(d.table, 1, 40) && str(d.text, 1, 200) && !('sticker' in d) && !('media' in d)
              && get(/databases/$(database)/documents/snakes/$(d.table)).data.host == request.auth.uid)
          || (d.kind == 'domino' && str(d.table, 1, 40) && str(d.text, 1, 200) && !('sticker' in d) && !('media' in d)
              && get(/databases/$(database)/documents/domino/$(d.table)).data.host == request.auth.uid)
        )
        && (!('replyTo' in d) || (
          d.replyTo is map
          && d.replyTo.keys().hasOnly(['name', 'text', 'uid'])
          && (!('uid' in d.replyTo) || str(d.replyTo.uid, 1, 128))
          && str(d.replyTo.name, 1, 30)
          && str(d.replyTo.text, 1, 200)
        ));
    }

    function mediaOk(path, type) {
      let m = get(path).data;
      return m.uid == request.auth.uid && m.type == type;
    }

    // ملف صورة أو فويس (بيتحفظ كـ base64 جوه Firestore — مجاني)
    function validMedia(d) {
      return d.keys().hasOnly(['uid', 'type', 'mime', 'data', 'createdAt'])
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && (
          (d.type == 'image' && d.mime == 'image/jpeg')
          || (d.type == 'voice' && d.mime in ['audio/mp4', 'audio/webm', 'audio/aac', 'audio/mpeg', 'audio/ogg'])
        )
        && d.data is string && d.data.size() > 0 && d.data.size() <= 950000;
    }

    // فلتر الشتايم: الأدمن بيحط الكلمات في config/filter، والنمط بيتبني في التطبيق
    function cleanText(t) {
      let p = /databases/$(database)/documents/config/filter;
      return !exists(p) || get(p).data.get('pattern', '') == '' || !t.lower().matches(get(p).data.pattern);
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }
    function roomName(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.name;
    }

    // تعديل رسالتي المكتوبة خلال ١٥ دقيقة من إرسالها
    function myEdit() {
      let d = request.resource.data;
      return resource.data.uid == request.auth.uid
        && resource.data.kind == 'text'
        && d.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
        && str(d.text, 1, 1000)
        && cleanText(d.text)
        && d.edited == true
        && d.editedAt == request.time
        && request.time < resource.data.createdAt + duration.value(15, 'm');
    }

    // التفاعلات بس، وكل واحد يغيّر تفاعله هو
    function onlyMyReaction() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reactions)
            || request.resource.data.reactions[request.auth.uid] in ['❤️', '😂', '👍', '😮', '😢']);
    }

    // ===== بيانات الأعضاء (عامة لأي حد مسجل) =====
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isMe(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMe(uid);

      function validUser(d) {
        return d.keys().hasOnly(['name', 'gender', 'bio', 'city', 'age', 'rooms', 'avatar', 'createdAt', 'updatedAt'])
          && (!('avatar' in d) || d.avatar == '' || (d.avatar is string && d.avatar.size() <= 80000
              && d.avatar.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
          && str(d.name, 1, 30)
          && d.gender in ['male', 'female']
          && (!('bio' in d) || str(d.bio, 0, 200))
          && (!('city' in d) || str(d.city, 0, 40))
          && (!('age' in d) || d.age == null || (d.age is int && d.age >= 13 && d.age <= 100))
          && (!('rooms' in d) || (d.rooms is list && d.rooms.size() <= 100))
          && d.updatedAt == request.time;
      }

      // صوري: ٦ صور بالكتير (أرقامها من ٠ لـ ٥)
      match /photos/{photoId} {
        allow read: if signedIn();
        allow create, update: if isMe(uid)
          && photoId in ['0', '1', '2', '3', '4', '5']
          && request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 300000
          && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
        allow delete: if isMe(uid);
      }
    }

    // ===== الأدوار =====
    // الأدمن بيتحدد من Firebase Console بس، والأدمن يعيّن المشرفين
    match /config/roles {
      allow read: if signedIn();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mods'])
        && request.resource.data.mods is map
        && request.resource.data.mods.size() <= 200;
      allow create, delete: if false;
    }

    // ===== متصل الآن =====
    // كل عضو بيحدّث وجوده كل شوية؛ لو عدّت دقيقة من غير تحديث يبقى مش متصل
    match /presence/{uid} {
      allow read: if signedIn();
      // at: آخر مرة كان فاتح التطبيق — room/roomAt: آخر غرفة كان فيها وإمتى
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['room', 'at', 'roomAt'])
        && request.resource.data.at == request.time
        && (!('roomAt' in request.resource.data)
            || request.resource.data.roomAt == request.time
            || (resource != null && request.resource.data.roomAt == resource.data.get('roomAt', null)))
        && (
          // نفس الغرفة اللي كان فيها (أو مفيش غرفة)
          (resource != null && request.resource.data.get('room', '') == resource.data.get('room', ''))
          || request.resource.data.get('room', '') == ''
          // غرفة جديدة: لازم تكون موجودة ووقتها دلوقتي
          || (request.resource.data.room is string && roomExists(request.resource.data.room)
              && request.resource.data.get('roomAt', null) == request.time)
        );
      allow delete: if isMe(uid);
    }

    // ===== الكلمات الممنوعة (الأدمن بس) =====
    match /config/filter {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['words', 'pattern', 'updatedAt'])
        && request.resource.data.words is list && request.resource.data.words.size() <= 300
        && request.resource.data.pattern is string && request.resource.data.pattern.size() <= 60000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ===== نقط مسابقة كيمت (ترتيب الأسبوع) =====
    // النقطة بتزيد بس مع إجابة صح في نفس اللحظة
    match /scores/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'points', 'week', 'room', 'updatedAt'])
        && request.resource.data.name == userDoc(uid).name
        && request.resource.data.updatedAt == request.time
        && str(request.resource.data.week, 1, 12)
        && str(request.resource.data.room, 1, 128)
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.room)/game/current).data.winner == uid
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.room)/game/current).data.solvedAt == request.time
        && request.resource.data.points == (
          resource == null || resource.data.week != request.resource.data.week ? 1 : resource.data.points + 1);
      allow delete: if false;
    }

    // ===== لودو كيمت =====
    // النرد بيطلع من وقت السيرفر (الميكروثانية) فمحدش يقدر يختار الرقم
    // وكل نقلة بتتراجع هنا: صاحب الدور بس، والقطعة بتمشي بعدد النرد بالظبط
    function ludoColors(n) {
      return n == 2 ? [0, 26] : n == 3 ? [0, 13, 26] : [0, 13, 26, 39];
    }
    function ludoAbs(rel, off) {
      return (off + rel - 1) % 52;
    }
    function ludoSafe(a) {
      return a in [0, 8, 13, 21, 26, 34, 39, 47];
    }
    function ludoStep(o, n, d) {
      return (o == 0 && d == 6 && n == 1) || (o > 0 && n == o + d && n <= 57);
    }
    function ludoCanMove(o, d) {
      return (o == 0 && d == 6) || (o > 0 && o + d <= 57);
    }
    // قطعة الخصم: زي ما هي، أو اتضربت ورجعت البيت (لو كانت في نفس المربع)
    function ludoHit(o, n, off, a, to) {
      return n == o || (n == 0 && o >= 1 && o <= 51 && to <= 51 && !ludoSafe(a) && ludoAbs(o, off) == a);
    }
    function ludoOppOk(j, D, N, a, to) {
      return j >= D.seats.size() || j == D.turn || !(('p' + string(j)) in N) || (
        N['p' + string(j)].size() == 4
        && ludoHit(D['p' + string(j)][0], N['p' + string(j)][0], D.colors[j], a, to)
        && ludoHit(D['p' + string(j)][1], N['p' + string(j)][1], D.colors[j], a, to)
        && ludoHit(D['p' + string(j)][2], N['p' + string(j)][2], D.colors[j], a, to)
        && ludoHit(D['p' + string(j)][3], N['p' + string(j)][3], D.colors[j], a, to));
    }
    // الرقم من الملي والميكرو ثانية بتوع وقت السيرفر
    // أنواع اللودو: classic عادي، night ليلي (شكل بس)، quick سريع (قطعتين)، luck حظ (⚡ و 💀)
    function ludoStart(m) {
      return m == 'quick' ? [0, 0, 57, 57] : [0, 0, 0, 0];
    }
    function ludoLuck(D) {
      return D.get('mode', 'classic') == 'luck';
    }
    // 💀 بترجّع القطعة البيت
    function ludoFinal(D, land, off) {
      return ludoLuck(D) && land >= 1 && land <= 51 && ludoAbs(land, off) in [6, 19, 32, 45] ? 0 : land;
    }
    // ⚡ بتدي دور زيادة
    function ludoBonus(D, land, off) {
      return ludoLuck(D) && land >= 1 && land <= 51 && ludoAbs(land, off) in [3, 16, 29, 42];
    }
    function ludoDice(D) {
      let x = int(D.rolledAt.nanos() / 1000);
      return (x % 1000 + int(x / 1000)) % 6 + 1;
    }
    function ludoSeated(D) {
      return signedIn() && request.auth.uid in D.seats;
    }
    function ludoMyTurn(D) {
      return signedIn() && D.status == 'playing' && D.seats[D.turn] == request.auth.uid;
    }
    function ludoOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function ludoNextTurn(D, N) {
      return N.turn is int && N.turn >= 0 && N.turn < D.seats.size() && N.turn != D.turn
        && N.phase == 'roll' && N.turnAt == request.time;
    }

    match /ludo/{tid} {
      allow read: if signedIn();
      // ترابيزة جديدة
      allow create: if signedIn() && !appBanned()
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'room', 'roomName', 'size', 'colors', 'seats', 'names',
             'p0', 'status', 'turn', 'phase', 'createdAt', 'left', 'mode'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName == userDoc(request.auth.uid).name
        && request.resource.data.size in [2, 4]
        && request.resource.data.colors == ludoColors(request.resource.data.size)
        && request.resource.data.seats == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data.get('mode', 'classic') in ['classic', 'night', 'quick', 'luck']
        && request.resource.data.p0 == ludoStart(request.resource.data.get('mode', 'classic'))
        && request.resource.data.status == 'waiting' && request.resource.data.turn == 0 && request.resource.data.phase == 'roll'
        && request.resource.data.left == {}
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.get('room', ''), 0, 128) && str(request.resource.data.get('roomName', ''), 0, 40);

      // عضو بيقعد على كرسي فاضي (ولو الكراسي كملت اللعب بيبدأ)
      allow update: if signedIn() && !appBanned()
        && resource.data.status == 'waiting'
        && !(request.auth.uid in resource.data.seats)
        && resource.data.seats.size() < resource.data.size
        && ludoOnly(['seats', 'names', 'p' + string(resource.data.seats.size()), 'status', 'turnAt'])
        && request.resource.data.seats == resource.data.seats.concat([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data['p' + string(resource.data.seats.size())] == ludoStart(resource.data.get('mode', 'classic'))
        && (resource.data.seats.size() + 1 == resource.data.size
              ? (request.resource.data.status == 'playing' && request.resource.data.turnAt == request.time)
              : request.resource.data.status == 'waiting');

      // صاحب الترابيزة يبدأ بالموجودين (٢ أو ٣)
      allow update: if isMe(resource.data.host) && resource.data.status == 'waiting' && resource.data.seats.size() >= 2
        && ludoOnly(['size', 'colors', 'status', 'turnAt'])
        && request.resource.data.size == resource.data.seats.size()
        && request.resource.data.colors == ludoColors(resource.data.seats.size())
        && request.resource.data.status == 'playing' && request.resource.data.turnAt == request.time;

      // رمي النرد
      allow update: if ludoMyTurn(resource.data) && resource.data.phase == 'roll'
        && ludoOnly(['phase', 'rolledAt'])
        && request.resource.data.phase == 'move' && request.resource.data.rolledAt == request.time;

      // تحريك قطعة
      allow update: if ludoMyTurn(resource.data) && resource.data.phase == 'move'
        && ludoOnly(['p0', 'p1', 'p2', 'p3', 'turn', 'phase', 'turnAt', 'last', 'status', 'winner', 'winnerName', 'finishedAt'])
        && ludoMove(resource.data, request.resource.data, ludoDice(resource.data), request.resource.data.last);

      // مفيش ولا قطعة تتحرك بالرقم ده: الدور يعدّي
      allow update: if ludoMyTurn(resource.data) && resource.data.phase == 'move'
        && ludoOnly(['turn', 'phase', 'turnAt'])
        && !ludoCanMove(resource.data['p' + string(resource.data.turn)][0], ludoDice(resource.data))
        && !ludoCanMove(resource.data['p' + string(resource.data.turn)][1], ludoDice(resource.data))
        && !ludoCanMove(resource.data['p' + string(resource.data.turn)][2], ludoDice(resource.data))
        && !ludoCanMove(resource.data['p' + string(resource.data.turn)][3], ludoDice(resource.data))
        && ludoNextTurn(resource.data, request.resource.data);

      // صاحب الدور اتأخر أو خرج: أي حد قاعد يعدّي الدور
      allow update: if ludoSeated(resource.data) && resource.data.status == 'playing'
        && !(request.auth.uid in resource.data.left)
        && (request.time > resource.data.turnAt + duration.value(45, 's') || resource.data.seats[resource.data.turn] in resource.data.left)
        && ludoOnly(['turn', 'phase', 'turnAt'])
        && ludoNextTurn(resource.data, request.resource.data);

      // اللاعب يخرج من اللعبة
      allow update: if ludoSeated(resource.data) && resource.data.status in ['waiting', 'playing']
        && ludoOnly(['left'])
        && request.resource.data.left.diff(resource.data.left).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.left[request.auth.uid] == true;

      // كل الباقيين خرجوا: آخر واحد يكسب
      allow update: if ludoSeated(resource.data) && resource.data.status == 'playing'
        && !(request.auth.uid in resource.data.left)
        && resource.data.left.size() == resource.data.seats.size() - 1
        && ludoOnly(['status', 'winner', 'winnerName', 'finishedAt'])
        && request.resource.data.status == 'done' && request.resource.data.winner == request.auth.uid
        && request.resource.data.winnerName == resource.data.names[request.auth.uid]
        && request.resource.data.finishedAt == request.time;

      allow delete: if isAdmin() || (isMe(resource.data.host) && resource.data.status != 'playing');

      // شات الترابيزة
      match /chat/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && !appBanned()
          && request.auth.uid in get(/databases/$(database)/documents/ludo/$(tid)).data.seats
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == userDoc(request.auth.uid).name
          && str(request.resource.data.text, 1, 120) && cleanText(request.resource.data.text)
          && request.resource.data.at == request.time;
      }
    }

    // النقلة نفسها
    function ludoMove(D, N, d, last) {
      let t = D.turn;
      let k = 'p' + string(t);
      let i = last.piece;
      let off = D.colors[t];
      let land = last.to;
      let fin = ludoFinal(D, land, off);
      let a = ludoAbs(land, off);
      // لو وقعت على 💀 مفيش ضرب
      let hitTo = fin == land ? land : 99;
      let hit = N.diff(D).affectedKeys().hasAny(['p0', 'p1', 'p2', 'p3'].removeAll([k]));
      let mine = N[k];
      let done = mine[0] == 57 && mine[1] == 57 && mine[2] == 57 && mine[3] == 57;
      return last.keys().hasOnly(['seat', 'piece', 'from', 'to', 'dice'])
        && last.seat == t && last.dice == d && i is int && i >= 0 && i <= 3
        && mine.size() == 4
        && last.from == D[k][i] && mine[i] == fin
        && ludoStep(D[k][i], land, d)
        && (i == 0 || mine[0] == D[k][0]) && (i == 1 || mine[1] == D[k][1])
        && (i == 2 || mine[2] == D[k][2]) && (i == 3 || mine[3] == D[k][3])
        && ludoOppOk(0, D, N, a, hitTo) && ludoOppOk(1, D, N, a, hitTo)
        && ludoOppOk(2, D, N, a, hitTo) && ludoOppOk(3, D, N, a, hitTo)
        && N.phase == 'roll' && N.turnAt == request.time
        && (done
              ? (N.status == 'done' && N.winner == request.auth.uid && N.winnerName == D.names[request.auth.uid] && N.finishedAt == request.time)
              : (N.status == 'playing'
                 && ((d == 6 || land == 57 || hit || ludoBonus(D, land, off)) ? N.turn == t : (N.turn is int && N.turn >= 0 && N.turn < D.seats.size() && N.turn != t))));
    }

    // مكسب لودو في ترتيب الأسبوع
    match /ludoScores/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'wins', 'week', 'table', 'updatedAt'])
        && request.resource.data.name == userDoc(uid).name
        && request.resource.data.updatedAt == request.time
        && str(request.resource.data.week, 1, 12) && str(request.resource.data.table, 1, 40)
        && getAfter(/databases/$(database)/documents/ludo/$(request.resource.data.table)).data.winner == uid
        && getAfter(/databases/$(database)/documents/ludo/$(request.resource.data.table)).data.finishedAt == request.time
        && request.resource.data.wins == (
          resource == null || resource.data.week != request.resource.data.week ? 1 : resource.data.wins + 1);
      allow delete: if false;
    }

    // ===== السلم والتعبان =====
    match /snakes/{tid} {
      allow read: if signedIn();
      // ترابيزة جديدة
      allow create: if signedIn() && !appBanned()
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'room', 'roomName', 'size', 'colors', 'seats', 'names',
             'p0', 'status', 'turn', 'phase', 'createdAt', 'left', 'mode'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName == userDoc(request.auth.uid).name
        && request.resource.data.size in [2, 4]
        && request.resource.data.colors == ludoColors(request.resource.data.size)
        && request.resource.data.seats == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data.p0 == 0
        && request.resource.data.status == 'waiting' && request.resource.data.turn == 0 && request.resource.data.phase == 'roll'
        && request.resource.data.left == {}
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.get('room', ''), 0, 128) && str(request.resource.data.get('roomName', ''), 0, 40);

      // عضو بيقعد على كرسي فاضي (ولو الكراسي كملت اللعب بيبدأ)
      allow update: if signedIn() && !appBanned()
        && resource.data.status == 'waiting'
        && !(request.auth.uid in resource.data.seats)
        && resource.data.seats.size() < resource.data.size
        && ludoOnly(['seats', 'names', 'p' + string(resource.data.seats.size()), 'status', 'turnAt'])
        && request.resource.data.seats == resource.data.seats.concat([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data['p' + string(resource.data.seats.size())] == 0
        && (resource.data.seats.size() + 1 == resource.data.size
              ? (request.resource.data.status == 'playing' && request.resource.data.turnAt == request.time)
              : request.resource.data.status == 'waiting');

      // صاحب الترابيزة يبدأ بالموجودين (٢ أو ٣)
      allow update: if isMe(resource.data.host) && resource.data.status == 'waiting' && resource.data.seats.size() >= 2
        && ludoOnly(['size', 'colors', 'status', 'turnAt'])
        && request.resource.data.size == resource.data.seats.size()
        && request.resource.data.colors == ludoColors(resource.data.seats.size())
        && request.resource.data.status == 'playing' && request.resource.data.turnAt == request.time;

      // رمي النرد
      allow update: if ludoMyTurn(resource.data) && resource.data.phase == 'roll'
        && ludoOnly(['phase', 'rolledAt'])
        && request.resource.data.phase == 'move' && request.resource.data.rolledAt == request.time;

      // السلم والتعبان: الحركة بعدد النرد، والسلم بيطلّعك والتعبان بينزّلك
      allow update: if ludoMyTurn(resource.data) && resource.data.phase == 'move'
        && ludoOnly(['p0', 'p1', 'p2', 'p3', 'turn', 'phase', 'turnAt', 'last', 'status', 'winner', 'winnerName', 'finishedAt'])
        && snMove(resource.data, request.resource.data, ludoDice(resource.data), request.resource.data.last);

      // صاحب الدور اتأخر أو خرج: أي حد قاعد يعدّي الدور
      allow update: if ludoSeated(resource.data) && resource.data.status == 'playing'
        && !(request.auth.uid in resource.data.left)
        && (request.time > resource.data.turnAt + duration.value(45, 's') || resource.data.seats[resource.data.turn] in resource.data.left)
        && ludoOnly(['turn', 'phase', 'turnAt'])
        && ludoNextTurn(resource.data, request.resource.data);

      // اللاعب يخرج من اللعبة
      allow update: if ludoSeated(resource.data) && resource.data.status in ['waiting', 'playing']
        && ludoOnly(['left'])
        && request.resource.data.left.diff(resource.data.left).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.left[request.auth.uid] == true;

      // كل الباقيين خرجوا: آخر واحد يكسب
      allow update: if ludoSeated(resource.data) && resource.data.status == 'playing'
        && !(request.auth.uid in resource.data.left)
        && resource.data.left.size() == resource.data.seats.size() - 1
        && ludoOnly(['status', 'winner', 'winnerName', 'finishedAt'])
        && request.resource.data.status == 'done' && request.resource.data.winner == request.auth.uid
        && request.resource.data.winnerName == resource.data.names[request.auth.uid]
        && request.resource.data.finishedAt == request.time;

      allow delete: if isAdmin() || (isMe(resource.data.host) && resource.data.status != 'playing');

      // شات الترابيزة
      match /chat/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && !appBanned()
          && request.auth.uid in get(/databases/$(database)/documents/snakes/$(tid)).data.seats
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == userDoc(request.auth.uid).name
          && str(request.resource.data.text, 1, 120) && cleanText(request.resource.data.text)
          && request.resource.data.at == request.time;
      }
    }

    function snJump(n) {
      return {'4': 25, '13': 46, '33': 49, '42': 63, '50': 69, '62': 81, '74': 92,
              '27': 5, '40': 3, '43': 18, '54': 31, '66': 45, '76': 58, '89': 53, '99': 41}.get(string(n), n);
    }
    function snMove(D, N, d, last) {
      let t = D.turn;
      let k = 'p' + string(t);
      let o = D[k];
      let to = o + d > 100 ? o : snJump(o + d);
      return N.diff(D).affectedKeys().hasOnly([k, 'turn', 'phase', 'turnAt', 'last', 'status', 'winner', 'winnerName', 'finishedAt'])
        && N[k] == to
        && last.keys().hasOnly(['seat', 'from', 'to', 'dice']) && last.seat == t && last.from == o && last.to == to && last.dice == d
        && N.phase == 'roll' && N.turnAt == request.time
        && (to == 100
              ? (N.status == 'done' && N.winner == request.auth.uid && N.winnerName == D.names[request.auth.uid] && N.finishedAt == request.time)
              : (N.status == 'playing'
                 && (d == 6 ? N.turn == t : (N.turn is int && N.turn >= 0 && N.turn < D.seats.size() && N.turn != t))));
    }

    // مكسب السلم والتعبان في ترتيب الأسبوع
    match /snakesScores/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'wins', 'week', 'table', 'updatedAt'])
        && request.resource.data.name == userDoc(uid).name
        && request.resource.data.updatedAt == request.time
        && str(request.resource.data.week, 1, 12) && str(request.resource.data.table, 1, 40)
        && getAfter(/databases/$(database)/documents/snakes/$(request.resource.data.table)).data.winner == uid
        && getAfter(/databases/$(database)/documents/snakes/$(request.resource.data.table)).data.finishedAt == request.time
        && request.resource.data.wins == (
          resource == null || resource.data.week != request.resource.data.week ? 1 : resource.data.wins + 1);
      allow delete: if false;
    }

    // ===== الدومينو =====
    // ٢٨ حتة (دبل ٦). كل حتة رقمها x = صغير×٧ + كبير
    // ورق كل لاعب في مكان محدش يقراه غيره، والسحب حتة حتة
    function dLo(x) { return int(x / 7); }
    function dHi(x) { return x % 7; }
    function dPips(x) { return dLo(x) + dHi(x); }
    // الحتة متحطوطة على الترابيزة بأي اتجاه (o) لازم تبقى نفس الحتة (x)
    function dSame(o, x) {
      return (dLo(o) == dLo(x) && dHi(o) == dHi(x)) || (dLo(o) == dHi(x) && dHi(o) == dLo(x));
    }
    function dTable(tid) { return /databases/$(database)/documents/domino/$(tid); }
    function dHand(tid, uid) { return /databases/$(database)/documents/domino/$(tid)/hands/$(uid); }
    function dOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function dMyTurn(D) { return signedIn() && D.status == 'playing' && D.seats[D.turn] == request.auth.uid; }
    function dNext(D, N) {
      return N.turn is int && N.turn >= 0 && N.turn < D.seats.size() && N.turn != D.turn && N.turnAt == request.time;
    }
    function dPlay(tid, D, N) {
      let t = D.turn;
      let k = 'c' + string(t);
      let me = request.auth.uid;
      let before = get(dHand(tid, me)).data;
      let after = getAfter(dHand(tid, me)).data;
      let x = N.last.x;
      let o = N.last.o;
      let n = D.chain.size();
      return N.last.keys().hasOnly(['seat', 'kind', 'x', 'o', 'side', 'at']) && N.last.kind == 'play'
        && N.last.seat == t && N.last.at == request.time
        && x in before.tiles && after.tiles == before.tiles.removeAll([x]) && after.sum == before.sum - dPips(x)
        && dSame(o, x)
        && (n == 0 ? N.chain == [o]
            : N.last.side == 'L' ? (dHi(o) == dLo(D.chain[0]) && N.chain == [o].concat(D.chain))
            : (N.last.side == 'R' && dLo(o) == dHi(D.chain[n - 1]) && N.chain == D.chain.concat([o])))
        && N[k] == D[k] - 1 && N.passes == 0
        && (N[k] == 0
              ? (N.status == 'done' && N.winner == me && N.winnerName == D.names[me] && N.finishedAt == request.time)
              : (N.status == 'playing' && dNext(D, N)));
    }
    function dDraw(tid, D, N) {
      let t = D.turn;
      let k = 'c' + string(t);
      let me = request.auth.uid;
      let before = get(dHand(tid, me)).data;
      let after = getAfter(dHand(tid, me)).data;
      let bx = get(/databases/$(database)/documents/domino/$(tid)/bone/$(string(D.next))).data.x;
      return D.size < 4 && D.next < 28
        && N.last.keys().hasOnly(['seat', 'kind', 'at']) && N.last.kind == 'draw' && N.last.seat == t && N.last.at == request.time
        && after.tiles == before.tiles.concat([bx]) && after.sum == before.sum + dPips(bx)
        && N.next == D.next + 1 && N[k] == D[k] + 1 && N.turnAt == request.time;
    }

    match /domino/{tid} {
      allow read: if signedIn();
      allow create: if signedIn() && !appBanned()
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'room', 'roomName', 'size', 'seats', 'names', 'status', 'turn', 'createdAt', 'left', 'chain', 'passes'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName == userDoc(request.auth.uid).name
        && request.resource.data.size in [2, 4]
        && request.resource.data.seats == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data.status == 'waiting' && request.resource.data.turn == 0
        && request.resource.data.left == {} && request.resource.data.chain == [] && request.resource.data.passes == 0
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.get('room', ''), 0, 128) && str(request.resource.data.get('roomName', ''), 0, 40);

      // القعدة (ولو الكراسي كملت: صاحب الترابيزة يوزّع)
      allow update: if signedIn() && !appBanned() && resource.data.status == 'waiting'
        && !(request.auth.uid in resource.data.seats) && resource.data.seats.size() < resource.data.size
        && dOnly(['seats', 'names', 'status'])
        && request.resource.data.seats == resource.data.seats.concat([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == userDoc(request.auth.uid).name
        && request.resource.data.status == (resource.data.seats.size() + 1 == resource.data.size ? 'deal' : 'waiting');

      // صاحب الترابيزة يبدأ بالموجودين (٢ أو ٣)
      allow update: if isMe(resource.data.host) && resource.data.status == 'waiting' && resource.data.seats.size() >= 2
        && dOnly(['size', 'status'])
        && request.resource.data.size == resource.data.seats.size() && request.resource.data.status == 'deal';

      // التوزيع (صاحب الترابيزة): كل واحد ٧ حتت، والباقي للسحب
      allow update: if isMe(resource.data.host) && resource.data.status == 'deal'
        && dOnly(['status', 'turn', 'turnAt', 'next', 'c0', 'c1', 'c2', 'c3'])
        && request.resource.data.status == 'playing' && request.resource.data.turnAt == request.time
        && request.resource.data.turn is int && request.resource.data.turn >= 0 && request.resource.data.turn < resource.data.seats.size()
        && request.resource.data.next == 7 * resource.data.seats.size()
        && request.resource.data.c0 == 7 && request.resource.data.c1 == 7
        && (resource.data.seats.size() < 3 || request.resource.data.c2 == 7)
        && (resource.data.seats.size() < 4 || request.resource.data.c3 == 7);

      // لعب حتة
      allow update: if dMyTurn(resource.data)
        && dOnly(['chain', 'c0', 'c1', 'c2', 'c3', 'turn', 'turnAt', 'passes', 'last', 'status', 'winner', 'winnerName', 'finishedAt'])
        && dPlay(tid, resource.data, request.resource.data);

      // سحب حتة (١ ضد ١ بس)
      allow update: if dMyTurn(resource.data)
        && dOnly(['next', 'c0', 'c1', 'c2', 'c3', 'last', 'turnAt'])
        && dDraw(tid, resource.data, request.resource.data);

      // مفيش لعب (أو اتأخر/خرج): الدور يعدّي، ولو الكل عدّى اللعبة بتقفل
      allow update: if signedIn() && resource.data.status == 'playing'
        && request.auth.uid in resource.data.seats && !(request.auth.uid in resource.data.left)
        && (resource.data.seats[resource.data.turn] == request.auth.uid
              ? (resource.data.size == 4 || resource.data.next >= 28)
              : (request.time > resource.data.turnAt + duration.value(45, 's') || resource.data.seats[resource.data.turn] in resource.data.left))
        && dOnly(['turn', 'turnAt', 'passes', 'last', 'status', 'blockedAt'])
        && request.resource.data.passes == resource.data.passes + 1
        && request.resource.data.last.keys().hasOnly(['seat', 'kind', 'at']) && request.resource.data.last.kind == 'pass'
        && request.resource.data.last.seat == resource.data.turn && request.resource.data.last.at == request.time
        && (request.resource.data.passes >= resource.data.seats.size()
              ? (request.resource.data.status == 'blocked' && request.resource.data.blockedAt == request.time)
              : (request.resource.data.status == 'playing' && dNext(resource.data, request.resource.data)));

      // اللعبة اتقفلت: كل واحد يكشف مجموع نقطه
      allow update: if signedIn() && resource.data.status == 'blocked'
        && request.resource.data.revealSeat is int && resource.data.seats[request.resource.data.revealSeat] == request.auth.uid
        && dOnly(['r' + string(request.resource.data.revealSeat), 'revealSeat'])
        && request.resource.data['r' + string(request.resource.data.revealSeat)] == get(dHand(tid, request.auth.uid)).data.sum;

      // أقل مجموع يكسب (أو بعد ٣٠ ثانية من غير ما الباقيين يكشفوا)
      allow update: if signedIn() && resource.data.status == 'blocked'
        && request.resource.data.winnerSeat is int && resource.data.seats[request.resource.data.winnerSeat] == request.auth.uid
        && ('r' + string(request.resource.data.winnerSeat)) in resource.data
        && dOnly(['status', 'winner', 'winnerName', 'winnerSeat', 'finishedAt'])
        && request.resource.data.status == 'done' && request.resource.data.winner == request.auth.uid
        && request.resource.data.winnerName == resource.data.names[request.auth.uid] && request.resource.data.finishedAt == request.time
        && dLow(0, resource.data, request.resource.data.winnerSeat) && dLow(1, resource.data, request.resource.data.winnerSeat)
        && dLow(2, resource.data, request.resource.data.winnerSeat) && dLow(3, resource.data, request.resource.data.winnerSeat);

      // الخروج، وآخر واحد فاضل يكسب
      allow update: if signedIn() && request.auth.uid in resource.data.seats && resource.data.status in ['waiting', 'deal', 'playing', 'blocked']
        && dOnly(['left'])
        && request.resource.data.left.diff(resource.data.left).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.left[request.auth.uid] == true;
      allow update: if signedIn() && request.auth.uid in resource.data.seats && resource.data.status in ['playing', 'blocked']
        && !(request.auth.uid in resource.data.left)
        && resource.data.left.size() == resource.data.seats.size() - 1
        && dOnly(['status', 'winner', 'winnerName', 'finishedAt'])
        && request.resource.data.status == 'done' && request.resource.data.winner == request.auth.uid
        && request.resource.data.winnerName == resource.data.names[request.auth.uid] && request.resource.data.finishedAt == request.time;

      allow delete: if isAdmin() || (isMe(resource.data.host) && resource.data.status in ['waiting', 'done']);

      // ورق كل لاعب: هو بس اللي يشوفه (وبعد ما اللعبة تخلص الكل يشوف)
      match /hands/{uid} {
        allow read: if isMe(uid) || (signedIn() && get(dTable(tid)).data.status == 'done');
        allow create: if signedIn() && get(dTable(tid)).data.host == request.auth.uid
          && get(dTable(tid)).data.status == 'deal' && uid in get(dTable(tid)).data.seats
          && request.resource.data.keys().hasOnly(['tiles', 'sum'])
          && request.resource.data.tiles is list && request.resource.data.tiles.size() == 7
          && request.resource.data.sum == dPips(request.resource.data.tiles[0]) + dPips(request.resource.data.tiles[1])
               + dPips(request.resource.data.tiles[2]) + dPips(request.resource.data.tiles[3]) + dPips(request.resource.data.tiles[4])
               + dPips(request.resource.data.tiles[5]) + dPips(request.resource.data.tiles[6]);
        // بيتغيّر بس مع لعب أو سحب في نفس اللحظة (قواعد الترابيزة بتتأكد من الباقي)
        allow update: if isMe(uid) && request.resource.data.keys().hasOnly(['tiles', 'sum'])
          && getAfter(dTable(tid)).data.last.at == request.time
          && getAfter(dTable(tid)).data.seats[getAfter(dTable(tid)).data.last.seat] == uid;
      }
      // حتت السحب: كل حتة لوحدها، ومحدش يشوف غير اللي عليه الدور يسحبها
      match /bone/{i} {
        allow get: if signedIn() && get(dTable(tid)).data.status == 'playing'
          && get(dTable(tid)).data.seats[get(dTable(tid)).data.turn] == request.auth.uid
          && i == string(get(dTable(tid)).data.next);
        allow create: if signedIn() && get(dTable(tid)).data.host == request.auth.uid && get(dTable(tid)).data.status == 'deal'
          && request.resource.data.keys().hasOnly(['x']) && request.resource.data.x is int
          && request.resource.data.x >= 0 && request.resource.data.x <= 48;
      }
      match /chat/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && !appBanned()
          && request.auth.uid in get(dTable(tid)).data.seats
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == userDoc(request.auth.uid).name
          && str(request.resource.data.text, 1, 120) && cleanText(request.resource.data.text)
          && request.resource.data.at == request.time;
      }
    }
    // مقارنة مجموع النقط (الأقل يكسب، ولو اتساووا الأول في الترتيب)
    function dLow(j, D, w) {
      let mine = D['r' + string(w)];
      return j >= D.seats.size() || j == w
        || (!(('r' + string(j)) in D) && request.time > D.blockedAt + duration.value(30, 's'))
        || ((('r' + string(j)) in D) && (D['r' + string(j)] > mine || (D['r' + string(j)] == mine && j > w)));
    }

    // مكسب الدومينو في ترتيب الأسبوع
    match /dominoScores/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'wins', 'week', 'table', 'updatedAt'])
        && request.resource.data.name == userDoc(uid).name
        && request.resource.data.updatedAt == request.time
        && str(request.resource.data.week, 1, 12) && str(request.resource.data.table, 1, 40)
        && getAfter(/databases/$(database)/documents/domino/$(request.resource.data.table)).data.winner == uid
        && getAfter(/databases/$(database)/documents/domino/$(request.resource.data.table)).data.finishedAt == request.time
        && request.resource.data.wins == (
          resource == null || resource.data.week != request.resource.data.week ? 1 : resource.data.wins + 1);
      allow delete: if false;
    }

    // ===== سجل الأخطاء (علشان نصلّح المشاكل اللي بتحصل عند الأعضاء) =====
    match /diag/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'where', 'msg', 'info', 'ua', 'ver', 'at'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.where, 1, 60) && str(request.resource.data.msg, 0, 300)
        && str(request.resource.data.info, 0, 300) && str(request.resource.data.ua, 0, 200)
        && str(request.resource.data.ver, 0, 30) && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // ===== الحظر من التطبيق كله =====
    match /bans/{uid} {
      allow read: if isAdmin() || isMe(uid);
      allow create, update: if isAdmin()
        && !(uid in roles().get('admins', []))
        && request.resource.data.keys().hasOnly(['name', 'reason', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && str(request.resource.data.name, 0, 30)
        && str(request.resource.data.reason, 0, 200);
      allow delete: if isAdmin();
    }

    // ===== إعدادات الخصوصية (سرية — صاحبها بس يشوفها) =====
    // فيها قايمة المحظورين، فالمحظور ميعرفش إنه اتحظر
    match /settings/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['blocked', 'dmWho', 'receipts', 'showOnline', 'notif'])
        && (!('notif' in request.resource.data) || (
          request.resource.data.notif is map
          && request.resource.data.notif.keys().hasOnly(['dms', 'mentions'])
          && request.resource.data.notif.get('dms', true) is bool
          && request.resource.data.notif.get('mentions', true) is bool
        ))
        && (!('blocked' in request.resource.data) || (request.resource.data.blocked is map && request.resource.data.blocked.size() <= 1000))
        && (!('dmWho' in request.resource.data) || request.resource.data.dmWho in ['all', 'rooms', 'none'])
        && (!('receipts' in request.resource.data) || request.resource.data.receipts is bool)
        && (!('showOnline' in request.resource.data) || request.resource.data.showOnline is bool);
    }

    // ===== الغرف =====
    match /rooms/{roomId} {
      allow read: if signedIn();
      // الأدمن بس اللي يعمل غرف جديدة ويغيّر أساميها ويمسحها
      allow create: if (signedIn() && roomId in defaultRooms() && request.resource.data == defaultRooms()[roomId])
        || (isAdmin()
          && request.resource.data.keys().hasOnly(['name', 'order', 'createdBy', 'createdAt'])
          && str(request.resource.data.name, 1, 30)
          && request.resource.data.order is int
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time);
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'order'])
        && str(request.resource.data.name, 1, 30)
        && request.resource.data.order is int)
        // صورة الغرفة: الأدمن أو مشرف الغرفة
        || (isRoomMod(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
          && (request.resource.data.photo == '' || (
            request.resource.data.photo is string
            && request.resource.data.photo.size() <= 90000
            && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))))
        // الإعلان المثبّت: الأدمن أو مشرف الغرفة
        || (isRoomMod(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && (request.resource.data.get('pinned', null) == null || (
            request.resource.data.pinned is map
            && request.resource.data.pinned.keys().hasOnly(['text', 'by', 'byName', 'at'])
            && str(request.resource.data.pinned.text, 1, 300)
            && cleanText(request.resource.data.pinned.text)
            && request.resource.data.pinned.by == request.auth.uid
            && str(request.resource.data.pinned.byName, 1, 30)
            && request.resource.data.pinned.at == request.time
          )));
      allow delete: if isAdmin();

      // ===== مسابقة كيمت =====
      // المشرف أو الأدمن يبدأ السؤال، والإجابة متشفّرة (sha256)
      // أول عضو يبعت إجابة تشفيرها مطابق هو اللي بيكسب، والسيرفر هو اللي بيتأكد
      match /game/{gameId} {
        allow read: if signedIn();
        allow create, update: if isRoomMod(roomId) && gameId == 'current'
          && request.resource.data.keys().hasOnly(['type', 'prompt', 'hint', 'hashes', 'round', 'total', 'status',
               'startedBy', 'startedByName', 'roundAt', 'answer', 'winner', 'winnerName', 'solvedAt'])
          && str(request.resource.data.prompt, 1, 300)
          && request.resource.data.hashes is list && request.resource.data.hashes.size() <= 8
          && request.resource.data.round is int && request.resource.data.total is int && request.resource.data.total <= 30
          && request.resource.data.status in ['open', 'solved', 'timeout', 'ended']
          // المشرف مايقدرش يكسّب نفسه أو حد تاني
          && (request.resource.data.winner == '' || (resource != null && request.resource.data.winner == resource.data.winner));
        // عضو جاوب صح
        allow update: if signedIn() && gameId == 'current'
          && resource.data.status == 'open'
          && !appBanned() && !restricted(roomId, 'any')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winner', 'winnerName', 'answer', 'solvedAt'])
          && request.resource.data.status == 'solved'
          && request.resource.data.winner == request.auth.uid
          && request.resource.data.winnerName == userDoc(request.auth.uid).name
          && request.resource.data.solvedAt == request.time
          && str(request.resource.data.answer, 1, 100)
          && hashing.sha256(request.resource.data.answer).toHexString().lower() in resource.data.hashes;
        allow delete: if isRoomMod(roomId);
      }

      // كتم أو طرد عضو من الغرفة (المشرف أو الأدمن)
      // المشرف مايقدرش يكتم أو يطرد الأدمن أو مشرف تاني
      match /restrict/{uid} {
        allow read: if signedIn();
        allow create, update: if isRoomMod(roomId)
          && uid != request.auth.uid
          && !(uid in roles().get('admins', []))
          && (isAdmin() || !(uid in roles().get('mods', {}).get(roomId, [])))
          && request.resource.data.keys().hasOnly(['type', 'until', 'name', 'by', 'byName', 'at'])
          && request.resource.data.type in ['mute', 'ban']
          && request.resource.data.until is timestamp
          && request.resource.data.until > request.time
          && request.resource.data.until < request.time + duration.value(8, 'd')
          && str(request.resource.data.name, 0, 30)
          && request.resource.data.by == request.auth.uid
          && str(request.resource.data.byName, 1, 30)
          && request.resource.data.at == request.time;
        allow delete: if isRoomMod(roomId);
      }

      match /media/{mediaId} {
        allow read: if signedIn();
        allow create: if signedIn() && roomExists(roomId) && !appBanned() && validMedia(request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /messages/{msgId} {
        // المطرود مايقدرش يقرا الغرفة
        allow read: if signedIn() && !restricted(roomId, 'ban');
        // المكتوم والمطرود والمحظور من التطبيق مايقدروش يكتبوا
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && !appBanned()
          && !restricted(roomId, 'any')
          && validRoomMessage(request.resource.data);
        allow update: if signedIn() && !restricted(roomId, 'any') && (onlyMyReaction() || (!appBanned() && myEdit()));
        // صاحب الرسالة، أو مشرف الغرفة، أو الأدمن
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isRoomMod(roomId));

        function validRoomMessage(d) {
          let me = userDoc(request.auth.uid);
          return d.keys().hasOnly(['uid', 'name', 'gender', 'kind', 'text', 'sticker', 'media', 'w', 'h', 'dur', 'replyTo', 'table', 'thumb', 'createdAt'])
            && d.uid == request.auth.uid
            && d.name == me.name
            && d.gender == me.gender
            && validContent(d, /databases/$(database)/documents/rooms/$(roomId)/media/$(d.get('media', 'none')));
        }
      }
    }

    // ===== الرسائل الخاصة =====
    // رقم المحادثة = رقمين العضوين مترتبين وبينهم _
    match /chats/{chatId} {
      function members() {
        return chatId.split('_');
      }
      function otherOf(list) {
        return list[0] == request.auth.uid ? list[1] : list[0];
      }

      // ينفع أبعت للعضو ده؟ (مش حاظرني + إعداد "مين يقدر يبعتلك" يسمح)
      // لو هو كان بعتلي قبل كده في المحادثة دي، يبقى أقدر أرد عليه حتى لو قافل الخاص
      function canMessage(other, chat) {
        let path = /databases/$(database)/documents/settings/$(other);
        let st = exists(path) ? get(path).data : {};
        let who = st.get('dmWho', 'rooms');
        return !appBanned()
          && !(request.auth.uid in st.get('blocked', {}))
          && (
            chat.get('active', {}).get(other, false) == true
            || who == 'all'
            || (who == 'rooms' && userDoc(other).get('rooms', []).hasAny(userDoc(request.auth.uid).get('rooms', [])))
          );
      }

      allow get: if signedIn() && request.auth.uid in members();
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      // أول رسالة بتعمل المحادثة
      allow create: if signedIn()
        && members().size() == 2
        && request.auth.uid in members()
        && members()[0] < members()[1]
        && request.resource.data.members == members()
        && exists(/databases/$(database)/documents/users/$(otherOf(members())))
        && request.resource.data.keys().hasOnly(['members', 'last', 'updatedAt', 'unread', 'readAt', 'active', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && validLast()
        && request.resource.data.unread == {otherOf(members()): 1}
        && request.resource.data.active == {request.auth.uid: true}
        && !('readAt' in request.resource.data)
        && canMessage(otherOf(members()), request.resource.data);

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdAt == resource.data.createdAt
        && (sending() || reading() || typing() || fixLast());

      allow delete: if false;

      function validLast() {
        let l = request.resource.data.last;
        return l is map && l.keys().hasOnly(['uid', 'text', 'at'])
          && l.uid == request.auth.uid
          && l.at == request.time
          && str(l.text, 1, 100)
          && request.resource.data.updatedAt == request.time;
      }

      // بعتّ رسالة: آخر رسالة + عداد غير المقروء عند التاني يزيد واحد
      function sending() {
        let other = otherOf(resource.data.members);
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['last', 'updatedAt', 'unread', 'active'])
          && validLast()
          && d.unread.diff(resource.data.get('unread', {})).affectedKeys().hasOnly([other])
          && d.unread[other] == resource.data.get('unread', {}).get(other, 0) + 1
          && d.get('active', {}).diff(resource.data.get('active', {})).affectedKeys().hasOnly([request.auth.uid])
          && d.get('active', {}).get(request.auth.uid, true) == true
          && canMessage(other, resource.data);
      }

      // عدّلت أو مسحت آخر رسالة بعتها: أحدّث المعاينة بس (من غير ما أغيّر الوقت)
      function fixLast() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['last'])
          && d.last.keys().hasOnly(['uid', 'text', 'at'])
          && resource.data.last.uid == request.auth.uid
          && d.last.uid == request.auth.uid
          && d.last.at == resource.data.last.at
          && str(d.last.text, 1, 100);
      }

      // بكتب دلوقتي (علشان التاني يشوف "جاري الكتابة")
      function typing() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['typing'])
          && d.typing is map
          && d.typing.diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid])
          && d.typing[request.auth.uid] == request.time;
      }

      // قريت المحادثة: أصفّر العداد بتاعي، وأسجل وقت القراية (لو علامة القراءة شغالة)
      function reading() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['unread', 'readAt'])
          && d.get('unread', {}).diff(resource.data.get('unread', {})).affectedKeys().hasOnly([request.auth.uid])
          && d.get('unread', {}).get(request.auth.uid, 0) == 0
          && d.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in d.get('readAt', {})) || d.readAt[request.auth.uid] == request.time
              || d.readAt[request.auth.uid] == resource.data.get('readAt', {}).get(request.auth.uid, null));
      }

      // صور وفويس الخاص: العضوين بس يشوفوها
      match /media/{mediaId} {
        allow read: if signedIn() && request.auth.uid in members();
        allow create: if signedIn() && request.auth.uid in members() && members().size() == 2 && validMedia(request.resource.data);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /messages/{msgId} {
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if signedIn() && request.auth.uid in members();

        // الرسالة لازم تتبعت مع تحديث المحادثة في نفس اللحظة (وده اللي بيتأكد من الحظر والخصوصية)
        allow create: if signedIn()
          && request.auth.uid in members()
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'sticker', 'media', 'w', 'h', 'dur', 'replyTo', 'table', 'thumb', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && validContent(request.resource.data, /databases/$(database)/documents/chats/$(chatId)/media/$(request.resource.data.get('media', 'none')))
          && chatAfter().updatedAt == request.time
          && chatAfter().last.uid == request.auth.uid;

        allow update: if signedIn() && request.auth.uid in members() && (onlyMyReaction() || myEdit());
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // ===== البلاغات =====
    // بتتحفظ للمراجعة من Firebase Console بس
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'reported', 'reportedName', 'reason', 'chatId', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && str(request.resource.data.reported, 1, 128)
        && request.resource.data.reported != request.auth.uid
        && str(request.resource.data.reportedName, 0, 30)
        && request.resource.data.reason in ['إزعاج أو رسائل كتير', 'كلام أو صور مش لائقة', 'تحرش أو تهديد', 'حساب مزيف أو نصب', 'حاجة تانية']
        && (!('chatId' in request.resource.data) || str(request.resource.data.chatId, 1, 300))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ===== الإشعارات =====
    // كل عضو بيكتب إشعار للتاني لما يرد عليه أو يذكره أو يتفاعل على رسالته أو يبعتله خاص
    // القواعد بتتأكد إن الإشعار ليه رسالة حقيقية وراه، وإن المستقبل مش حاظر المرسل، وإنه مفعّل النوع ده
    match /notifications/{uid}/items/{itemId} {
      allow read, delete: if isMe(uid);

      // صاحب الإشعارات يعلّم إنه قراها بس
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow create: if signedIn() && validNotif(request.resource.data);

      // إشعار الخاص واحد لكل مرسل، وبيتحدّث مع كل رسالة جديدة
      allow update: if signedIn()
        && resource.data.from == request.auth.uid
        && itemId == 'dm_' + request.auth.uid
        && validNotif(request.resource.data);

      function allowedBy(cat) {
        let path = /databases/$(database)/documents/settings/$(uid);
        let st = exists(path) ? get(path).data : {};
        return !(request.auth.uid in st.get('blocked', {}))
          && st.get('notif', {}).get(cat, true) != false;
      }

      function validNotif(d) {
        return uid != request.auth.uid
          && d.keys().hasOnly(['type', 'from', 'fromName', 'text', 'roomId', 'roomName', 'msgId', 'emoji', 'createdAt', 'read'])
          && d.from == request.auth.uid
          && d.fromName == userDoc(request.auth.uid).name
          && d.createdAt == request.time
          && d.read == false
          && str(d.text, 0, 120)
          && (d.type == 'mod' || str(d.msgId, 1, 128))
          && (
            (d.type == 'dm' && itemId == 'dm_' + request.auth.uid && dmSource(d) && allowedBy('dms'))
            || (d.type in ['reply', 'mention', 'react'] && roomSource(d) && allowedBy('mentions'))
            || (d.type == 'mod' && isAdmin() && d.roomId is string && roomExists(d.roomId)
                && d.roomName == roomName(d.roomId)
                && uid in roles().get('mods', {}).get(d.roomId, []) && !('emoji' in d))
          );
      }

      function dmSource(d) {
        let chatId = request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid;
        let m = get(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.msgId)).data;
        return m.uid == request.auth.uid && !('roomId' in d) && !('emoji' in d);
      }

      function roomSource(d) {
        let m = get(/databases/$(database)/documents/rooms/$(d.roomId)/messages/$(d.msgId)).data;
        return d.roomId is string
          && d.roomName == roomName(d.roomId)
          && (
            (d.type == 'reply' && m.uid == request.auth.uid && m.get('replyTo', {}).get('uid', '') == uid && !('emoji' in d))
            || (d.type == 'mention' && m.uid == request.auth.uid && m.get('text', '').matches('(?s).*@.*') && !('emoji' in d))
            || (d.type == 'react' && itemId == 'react_' + d.msgId + '_' + request.auth.uid
                && m.uid == uid && m.get('reactions', {}).get(request.auth.uid, '') == d.emoji)
          );
      }
    }

    // أي حاجة تانية مقفولة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
